    <bpmn:scriptTask id="Activity_1wed9be" name="Extract owner list" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0soihea</bpmn:incoming>
      <bpmn:outgoing>Flow_0w9ix1q</bpmn:outgoing>
      <bpmn:script>var allApartments = JSON.parse(apartmentList);
   var selectedIds = JSON.parse(selectedApartmentIds);
   var ownerIds = new java.util.ArrayList();
   var relevant = [];
   var seenOwners = {};
   var selectedApartmentIdsList = new java.util.ArrayList();
   for (var i = 0; i &lt; allApartments.length; i++) {
     var apt = allApartments[i];
     if (selectedIds.indexOf(apt.apartmentId) !== -1) {
       relevant.push(apt);
       if (!seenOwners[apt.ownerId]) {
         seenOwners[apt.ownerId] = true;
         ownerIds.add(apt.ownerId);
       }
     }
   }
   for (var j = 0; j &lt; selectedIds.length; j++) {
     selectedApartmentIdsList.add(selectedIds[j]);
   }
   execution.setVariable('ownerIds', ownerIds);
   execution.setVariable('relevantApartments', JSON.stringify(relevant));
   execution.setVariable('selectedApartmentIdsList', selectedApartmentIdsList);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1hm8qh2" name="Send final terms" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0a3890e</bpmn:incoming>
      <bpmn:outgoing>Flow_0yoad4t</bpmn:outgoing>
      <bpmn:script>var allApartments = JSON.parse(apartmentList);
var selectedIds = JSON.parse(selectedApartmentIds);
var finalTerms = allApartments.filter(function(a) { return selectedIds.indexOf(a.apartmentId) !== -1; });
execution.setVariable('finalTerms', JSON.stringify(finalTerms));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0rq1mgx" sourceRef="Activity_0m1rxvr" targetRef="Activity_1kr47cm" />
    <bpmn:scriptTask id="Activity_1kr47cm" name="Resolve final owner" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0rq1mgx</bpmn:incoming>
      <bpmn:outgoing>Flow_0glkn1x</bpmn:outgoing>
      <bpmn:script>var allApartments = JSON.parse(apartmentList);
var selApId = execution.getVariable('selectedApartmentId');
var chosen = allApartments.filter(function(a) { return a.apartmentId === selApId; })[0];
execution.setVariable('finalOwnerId', chosen ? chosen.ownerId : null);
execution.setVariable('finalPrice', chosen ? chosen.price : null);</bpmn:script>
    </bpmn:scriptTask>
