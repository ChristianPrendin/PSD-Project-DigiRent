    <bpmn:scriptTask id="Activity_0woyof2" name="Gather owner availabilities" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0gnwk7t</bpmn:incoming>
      <bpmn:incoming>Flow_0qphteq</bpmn:incoming>
      <bpmn:outgoing>Flow_05rd4n4</bpmn:outgoing>
      <bpmn:script>var ids = ownerIds;
   var slotStrings = [];
   for (var i = 0; i &lt; ids.size(); i++) {
     var id = ids.get(i);
     var varName = 'ownerAvailability_' + id;
     if (execution.hasVariable(varName)) {
       slotStrings.push('{"ownerId":"' + id + '","slots":' + execution.getVariable(varName) + '}');
     }
   }
   execution.setVariable('ownerAvailabilities', '[' + slotStrings.join(',') + ']');</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:subProcess id="Activity_1fvf27s" name="Contact owners">
      <bpmn:incoming>Flow_0w9ix1q</bpmn:incoming>
      <bpmn:outgoing>Flow_0qphteq</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="ownerIds" camunda:elementVariable="ownerId" />
      <bpmn:startEvent id="Event_1n88n1e">
        <bpmn:outgoing>Flow_0rhngjw</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:receiveTask id="Activity_0148tuu" name="Receive owner availability" messageRef="Message_05egjrc">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="correlationId">${ownerId}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0igo86k</bpmn:incoming>
        <bpmn:outgoing>Flow_0cn5p8a</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:scriptTask id="Activity_03d0x25" name="Store owner availability" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_0cn5p8a</bpmn:incoming>
        <bpmn:outgoing>Flow_081ynnr</bpmn:outgoing>
        <bpmn:script>execution.setVariable('ownerAvailability_' + ownerId, availableSlots);</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Event_0s5rdhi">
        <bpmn:incoming>Flow_081ynnr</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0rhngjw" sourceRef="Event_1n88n1e" targetRef="Activity_11zvn2u" />
      <bpmn:sequenceFlow id="Flow_0igo86k" sourceRef="Activity_11zvn2u" targetRef="Activity_0148tuu" />
      <bpmn:sequenceFlow id="Flow_0cn5p8a" sourceRef="Activity_0148tuu" targetRef="Activity_03d0x25" />
      <bpmn:sequenceFlow id="Flow_081ynnr" sourceRef="Activity_03d0x25" targetRef="Event_0s5rdhi" />
      <bpmn:scriptTask id="Activity_11zvn2u" name="Request owner availability" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_0rhngjw</bpmn:incoming>
        <bpmn:outgoing>Flow_0igo86k</bpmn:outgoing>
        <bpmn:script>var HttpClient = Java.type('java.net.http.HttpClient');
var HttpRequest = Java.type('java.net.http.HttpRequest');
var BodyPublishers = Java.type('java.net.http.HttpRequest$BodyPublishers');
var BodyHandlers = Java.type('java.net.http.HttpResponse$BodyHandlers');
var URI = Java.type('java.net.URI');

var apts = JSON.parse(relevantApartments);
var matchingApt = apts.filter(function(a) { return a.ownerId === ownerId; })[0];
var client = HttpClient.newHttpClient();
var body = JSON.stringify({rentalId: execution.getProcessBusinessKey(), apartmentId: matchingApt ? matchingApt.apartmentId : null, requestedPeriodStart: startDate, requestedPeriodEnd: endDate});
var request = HttpRequest.newBuilder()
  .uri(URI.create('http://host.docker.internal:3002/owners/' + ownerId + '/visit-requests'))
  .header('Content-Type', 'application/json')
  .POST(BodyPublishers.ofString(body))
  .build();
client.send(request, BodyHandlers.ofString());</bpmn:script>
      </bpmn:scriptTask>
