      <bpmn:scriptTask id="Activity_0d53esf" name="Gather partner offers" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_184e539</bpmn:incoming>
        <bpmn:incoming>Flow_1hwysee</bpmn:incoming>
        <bpmn:outgoing>Flow_0yp9p32</bpmn:outgoing>
        <bpmn:script>var ids = partnerIdsList;
var offerStrings = [];
for (var i = 0; i &lt; ids.size(); i++) {
  var id = ids.get(i);
  var varName = 'partnerOffer_' + id;
  if (execution.hasVariable(varName)) {
    var apartmentsJson = execution.getVariable(varName);
    if (apartmentsJson !== '[]') {
      offerStrings.push('{"partnerId":"' + id + '","apartments":' + apartmentsJson + '}');
    }
  }
}
execution.setVariable('partnerOffers', '[' + offerStrings.join(',') + ']');</bpmn:script>
      </bpmn:scriptTask>
