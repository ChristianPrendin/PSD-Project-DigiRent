      <bpmn:scriptTask id="Activity_0vaw925" name="Notify partners outcome" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_0b5fedz</bpmn:incoming>
        <bpmn:outgoing>Flow_1edowwu</bpmn:outgoing>
        <bpmn:script>var HttpClient = Java.type('java.net.http.HttpClient');
var HttpRequest = Java.type('java.net.http.HttpRequest');
var BodyPublishers = Java.type('java.net.http.HttpRequest$BodyPublishers');
var BodyHandlers = Java.type('java.net.http.HttpResponse$BodyHandlers');
var URI = Java.type('java.net.URI');

var client = HttpClient.newHttpClient();
var offers = JSON.parse(partnerOffers);
for (var i = 0; i &lt; offers.length; i++) {
  var partnerId = offers[i].partnerId;
  var stage = (partnerId === currentPartnerId) ? 'apartment_selected' : 'apartment_not_selected';
  var body = JSON.stringify({rentalId: execution.getProcessBusinessKey(), stage: stage});
  var request = HttpRequest.newBuilder()
    .uri(URI.create('http://host.docker.internal:3003/partners/' + partnerId + '/notifications'))
    .header('Content-Type', 'application/json')
    .POST(BodyPublishers.ofString(body))
    .build();
  client.send(request, BodyHandlers.ofString());
}</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_19cxjdg" name="Notify partners (customer withdrawal)" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_1trlj1x</bpmn:incoming>
        <bpmn:outgoing>Flow_1hir32r</bpmn:outgoing>
        <bpmn:script>var HttpClient = Java.type('java.net.http.HttpClient');
var HttpRequest = Java.type('java.net.http.HttpRequest');
var BodyPublishers = Java.type('java.net.http.HttpRequest$BodyPublishers');
var BodyHandlers = Java.type('java.net.http.HttpResponse$BodyHandlers');
var URI = Java.type('java.net.URI');

var client = HttpClient.newHttpClient();
var offers = JSON.parse(partnerOffers);
for (var i = 0; i &lt; offers.length; i++) {
  var partnerId = offers[i].partnerId;
  var body = JSON.stringify({rentalId: execution.getProcessBusinessKey(), stage: 'customer_withdrew'});
  var request = HttpRequest.newBuilder()
    .uri(URI.create('http://host.docker.internal:3003/partners/' + partnerId + '/notifications'))
    .header('Content-Type', 'application/json')
    .POST(BodyPublishers.ofString(body))
    .build();
  client.send(request, BodyHandlers.ofString());
}</bpmn:script>
