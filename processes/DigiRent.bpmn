      <bpmn:scriptTask id="Activity_0k7nrt2" name="Pick next partner offer" scriptFormat="JavaScript">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="Output_1m7a51s" />
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1tgumnw</bpmn:incoming>
        <bpmn:outgoing>Flow_1v49aak</bpmn:outgoing>
        <bpmn:script>var remaining = (typeof remainingPartnerOffers !== 'undefined' &amp;&amp; remainingPartnerOffers !== null)
     ? JSON.parse(remainingPartnerOffers)
     : JSON.parse(partnerOffers);
   var current = remaining.shift();
   execution.setVariable('currentPartnerOffer', JSON.stringify(current));
   execution.setVariable('currentPartnerApartments', JSON.stringify(current.apartments));
   execution.setVariable('currentPartnerId', current.partnerId);
   execution.setVariable('remainingPartnerOffers', JSON.stringify(remaining));
   execution.setVariable('remainingCount', remaining.length);</bpmn:script>
