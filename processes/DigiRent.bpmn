      <bpmn:scriptTask id="Activity_1354yep" name="Allocate fee" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_13pnqwt</bpmn:incoming>
        <bpmn:outgoing>Flow_0dic34e</bpmn:outgoing>
        <bpmn:script>var PARTNER_FEE_SHARE = 0.5;
var digiRentFeeShare = agencyFee * (1 - PARTNER_FEE_SHARE);
execution.setVariable('digiRentFeeShare', digiRentFeeShare);</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0g2j2qw" name="Transfer to partner" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_00lv78g</bpmn:incoming>
        <bpmn:outgoing>Flow_147mq9h</bpmn:outgoing>
        <bpmn:script>var HttpClient = Java.type('java.net.http.HttpClient');
var HttpRequest = Java.type('java.net.http.HttpRequest');
var BodyPublishers = Java.type('java.net.http.HttpRequest$BodyPublishers');
var BodyHandlers = Java.type('java.net.http.HttpResponse$BodyHandlers');
var URI = Java.type('java.net.URI');

var PARTNER_FEE_SHARE = 0.5;
var partnerFee = agencyFee * PARTNER_FEE_SHARE;
var client = HttpClient.newHttpClient();
var body = JSON.stringify({rentalId: execution.getProcessBusinessKey(), rentAmount: finalPrice, partnerFee: partnerFee});
var request = HttpRequest.newBuilder()
  .uri(URI.create('http://host.docker.internal:3003/partners/' + currentPartnerId + '/payments'))
  .header('Content-Type', 'application/json')
  .POST(BodyPublishers.ofString(body))
  .build();
client.send(request, BodyHandlers.ofString());</bpmn:script>
